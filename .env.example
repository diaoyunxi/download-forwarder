# ============================================================
# download-forwarder 环境变量配置模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# ============================================================

# ===== 服务配置 =====
# 服务监听端口（默认 18735）
PORT=18735
# 绑定地址（默认 127.0.0.1，仅限本机访问）
HOST=127.0.0.1

# ===== 认证（可选）=====
# Bearer Token（留空则无需认证）
AUTH_TOKEN=

# ===== 下载配置 =====
# 默认下载目录（留空使用 ~/Downloads）
DOWNLOAD_DIR=
# 历史记录最大条数（默认 100）
MAX_HISTORY=100
# 已完成任务保留时间（秒，默认 1800 = 30分钟）
TASK_TTL_SECONDS=1800

# ===== 代理配置（可选）=====
# HTTP 代理地址
# HTTP_PROXY=
# HTTPS 代理地址
# HTTPS_PROXY=
